* ASAP5 TT: a five-stage ring oscillator, BSIM-CMG (LEVEL 72 VERSION 107), started from alternating node voltages
.include pdk/asap5/asap5/asap5PDK_r0p4/models/hspice/asap5_tt.pm
VDD vdd 0 0.7
.subckt inv in out vdd
MP out in vdd vdd pmos_rvt nfin=2 
MN out in 0 0 nmos_rvt nfin=2 
.ends
X1 n1 n2 vdd inv
X2 n2 n3 vdd inv
X3 n3 n4 vdd inv
X4 n4 n5 vdd inv
X5 n5 n1 vdd inv
C1 n1 0 0.1f
.ic v(n1)=0 v(n2)=0.7 v(n3)=0 v(n4)=0.7 v(n5)=0
.tran 0.1p 60p uic
.print tran v(n1) v(n3)
.end
